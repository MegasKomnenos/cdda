diff --git a/src/map.cpp b/src/map.cpp
index d20e5958464..4662de021ec 100644
--- a/src/map.cpp
+++ b/src/map.cpp
@@ -369,14 +369,19 @@ map &map::operator=( map && ) = default;
 
 static submap null_submap;
 
-std::list<std::unique_ptr<level_cache>> map::free_cache_pool;
+std::list<std::unique_ptr<level_cache>> &map::free_cache_pool()
+{
+    static auto *const pool = new std::list<std::unique_ptr<level_cache>>();
+    return *pool;
+}
 
 std::unique_ptr<level_cache, map::level_cache_free> map::alloc_cache()
 {
     std::unique_ptr<level_cache, level_cache_free> cache;
-    if( !free_cache_pool.empty() ) {
-        cache.reset( free_cache_pool.front().release() );
-        free_cache_pool.pop_front();
+    std::list<std::unique_ptr<level_cache>> &pool = free_cache_pool();
+    if( !pool.empty() ) {
+        cache.reset( pool.front().release() );
+        pool.pop_front();
         cache->clear();
     } else {
         cache.reset( new level_cache{} );
