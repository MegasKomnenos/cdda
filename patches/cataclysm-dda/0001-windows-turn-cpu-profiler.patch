+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace turn_profiler
+{
+
+std::uint64_t read_process_cycles()
+{
+#if defined(_WIN32)
+    ULONG64 cycles = 0;
+    if( QueryProcessCycleTime( GetCurrentProcess(), &cycles ) == 0 ) {
+        throw std::runtime_error( "QueryProcessCycleTime failed" );
+    }
+    return cycles;
+#else
+    throw std::runtime_error( "turn profiling is supported only on Windows" );
+#endif
+}
+
+std::uint64_t read_thread_cycles()
+{
+#if defined(_WIN32)
+    ULONG64 cycles = 0;
+    if( QueryThreadCycleTime( GetCurrentThread(), &cycles ) == 0 ) {
+        throw std::runtime_error( "QueryThreadCycleTime failed" );
+    }
+    return cycles;
+#else
+    throw std::runtime_error( "turn profiling is supported only on Windows" );
+#endif
+}
+
+std::uint64_t derive_background_cycles( const std::uint64_t process_start,
+                                        const std::uint64_t process_end,
+                                        const std::uint64_t primary_thread_start,
+                                        const std::uint64_t primary_thread_end )
+{
+    if( process_end < process_start || primary_thread_end < primary_thread_start ) {
+        return 0;
+    }
+    const std::uint64_t process_cycles = process_end - process_start;
+    const std::uint64_t primary_thread_cycles =
+        primary_thread_end - primary_thread_start;
+    return process_cycles > primary_thread_cycles
+           ? process_cycles - primary_thread_cycles
+           : 0;
+}
+
+namespace
+{
+
+std::unique_ptr<recorder> native_recorder;
+bool native_turn_is_open = false;
+
+std::uint64_t wall_microseconds()
+{
+    return static_cast<std::uint64_t>(
+               std::chrono::duration_cast<std::chrono::microseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch() )
+               .count() );
+}
+
+} // namespace
+
+scoped_region::scoped_region( const std::string_view id )
+{
+    if( native_recorder && native_turn_is_open ) {
+        native_recorder->enter_region( id, read_thread_cycles() );
+        armed = true;
+    }
+}
+
+scoped_region::~scoped_region()
+{
+    if( armed && native_recorder && native_turn_is_open ) {
+        try {
+            native_recorder->leave_region( read_thread_cycles() );
+        } catch( ... ) {
+            std::terminate();
+        }
+    }
+}
+
+void start( const std::size_t target_turns )
+{
+    native_recorder = std::make_unique<recorder>( target_turns );
+    native_turn_is_open = false;
+}
+
+void stop()
+{
+    native_recorder.reset();
+    native_turn_is_open = false;
+}
+
+void begin_turn( const std::int64_t game_turn )
+{
+    if( !native_recorder ) {
+        throw std::logic_error( "turn profiler is not active" );
+    }
+    const std::uint64_t process_cycles = read_process_cycles();
+    const std::uint64_t profiler_start = read_thread_cycles();
+    native_recorder->begin_turn( game_turn, process_cycles, profiler_start,
+                                 wall_microseconds() );
+    const std::uint64_t profiler_end = read_thread_cycles();
+    if( profiler_end >= profiler_start ) {
+        native_recorder->add_component_cycles( "profiler",
+                                               profiler_end - profiler_start );
+    }
+    native_turn_is_open = true;
+}
+
+void end_turn()
+{
+    if( !native_recorder || !native_turn_is_open ) {
+        throw std::logic_error( "turn profiler has no active turn" );
+    }
+    const std::uint64_t profiler_start = read_thread_cycles();
+    const std::uint64_t profiler_end = read_thread_cycles();
+    if( profiler_end >= profiler_start ) {
+        native_recorder->add_component_cycles( "profiler",
+                                               profiler_end - profiler_start );
+    }
+    native_recorder->end_turn( read_process_cycles(), profiler_end,
+                               wall_microseconds() );
+    native_turn_is_open = false;
+}
+
+bool is_active()
+{
+    return native_recorder != nullptr;
+}
+
+bool is_complete()
+{
+    return native_recorder &&
+           native_recorder->samples().size() >= native_recorder->target_turns();
+}
+
+const std::vector<turn_sample> &samples()
+{
+    if( !native_recorder ) {
+        throw std::logic_error( "turn profiler is not active" );
+    }
+    return native_recorder->samples();
+}
+
+recorder::recorder( const std::size_t target_turns )
+    : target_turn_count( target_turns )
+{
+    completed_samples.reserve( target_turns );
+}
+
+void recorder::begin_turn( const std::int64_t game_turn,
+                           const std::uint64_t process_cycles,
+                           const std::uint64_t primary_thread_cycles,
+                           const std::uint64_t wall_microseconds )
+{
+    if( turn_is_open ) {
+        throw std::logic_error(
+            "turn profiler began a turn while another turn was open" );
+    }
+    current_game_turn = game_turn;
+    turn_start_cycles = process_cycles;
+    turn_start_primary_thread_cycles = primary_thread_cycles;
+    turn_start_wall_microseconds = wall_microseconds;
+    current_components.clear();
+    region_stack.clear();
+    turn_is_open = true;
+}
+
+void recorder::enter_region( const std::string_view id,
+                             const std::uint64_t thread_cycles )
+{
+    if( !turn_is_open ) {
+        throw std::logic_error( "turn profiler entered a region outside a turn" );
+    }
+    region_stack.push_back( {std::string( id ), thread_cycles, 0} );
+}
+
+void recorder::leave_region( const std::uint64_t thread_cycles )
+{
+    if( region_stack.empty() ) {
+        throw std::logic_error( "turn profiler left a region with an empty stack" );
+    }
+
+    const open_region region = std::move( region_stack.back() );
+    region_stack.pop_back();
+    const std::uint64_t inclusive = thread_cycles >= region.start_cycles
+                                    ? thread_cycles - region.start_cycles
+                                    : 0;
+    const std::uint64_t exclusive =
+        inclusive >= region.child_cycles ? inclusive - region.child_cycles : 0;
+    component_sample &sample = current_components[region.id];
+    sample.inclusive_cycles += inclusive;
+    sample.exclusive_cycles += exclusive;
+    if( !region_stack.empty() ) {
+        region_stack.back().child_cycles += inclusive;
+    }
+}
+
+void recorder::add_component_cycles( const std::string_view id,
+                                     const std::uint64_t cycles )
+{
+    if( !turn_is_open ) {
+        throw std::logic_error(
+            "turn profiler added component cycles outside a turn" );
+    }
+    component_sample &sample = current_components[std::string( id )];
+    sample.inclusive_cycles += cycles;
+    sample.exclusive_cycles += cycles;
+}
+
+turn_sample recorder::end_turn( const std::uint64_t process_cycles,
+                                const std::uint64_t primary_thread_cycles,
+                                const std::uint64_t wall_microseconds )
+{
+    if( !turn_is_open ) {
+        throw std::logic_error( "turn profiler ended a turn while no turn was open" );
+    }
+    if( !region_stack.empty() ) {
+        throw std::logic_error( "turn profiler ended a turn with open regions" );
+    }
+
+    turn_sample result;
+    result.game_turn = current_game_turn;
+    result.total_cycles = process_cycles >= turn_start_cycles
+                          ? process_cycles - turn_start_cycles
+                          : 0;
+    result.elapsed_microseconds =
+        wall_microseconds >= turn_start_wall_microseconds
+        ? wall_microseconds - turn_start_wall_microseconds
+        : 0;
+    result.components = std::move( current_components );
+    const std::uint64_t background_cycles = derive_background_cycles(
+            turn_start_cycles, process_cycles, turn_start_primary_thread_cycles,
+            primary_thread_cycles );
+    if( background_cycles > 0 ) {
+        component_sample &background = result.components["background.other"];
+        background.inclusive_cycles += background_cycles;
+        background.exclusive_cycles += background_cycles;
+    }
+
+    std::set<std::string, std::less<>> explicit_ids;
+    std::vector<std::pair<std::string, std::uint64_t>> explicit_inclusive;
+    explicit_inclusive.reserve( result.components.size() );
+    for( const auto &[id, component] : result.components ) {
+        explicit_ids.insert( id );
+        explicit_inclusive.emplace_back( id, component.inclusive_cycles );
+    }
+    for( const auto &[id, inclusive_cycles] : explicit_inclusive ) {
+        std::size_t separator = id.rfind( '.' );
+        while( separator != std::string::npos ) {
+            const std::string parent = id.substr( 0, separator );
+            if( explicit_ids.count( parent ) != 0 ) {
+                break;
+            }
+            result.components[parent].inclusive_cycles += inclusive_cycles;
+            separator = parent.rfind( '.' );
+        }
+    }
+
+    std::uint64_t attributed_cycles = 0;
+    for( const auto &[id, component] : result.components ) {
+        static_cast<void>( id );
+        attributed_cycles += component.exclusive_cycles;
+    }
+    component_sample &unattributed = result.components["unattributed"];
+    if( result.total_cycles > attributed_cycles ) {
+        unattributed.inclusive_cycles = result.total_cycles - attributed_cycles;
+        unattributed.exclusive_cycles = unattributed.inclusive_cycles;
+    }
+
+    completed_samples.push_back( result );
+    turn_is_open = false;
+    return result;
+}
+
+const std::vector<turn_sample> &recorder::samples() const
+{
+    return completed_samples;
+}
+
+std::size_t recorder::target_turns() const
+{
+    return target_turn_count;
+}
+
+namespace
+{
+
+std::string json_escape( const std::string_view value )
+{
+    std::ostringstream result;
+    for( const unsigned char ch : value ) {
+        switch( ch ) {
+            case '"':
+                result << "\\\"";
+                break;
+            case '\\':
+                result << "\\\\";
+                break;
+            case '\b':
+                result << "\\b";
+                break;
+            case '\f':
+                result << "\\f";
+                break;
+            case '\n':
+                result << "\\n";
+                break;
+            case '\r':
+                result << "\\r";
+                break;
+            case '\t':
+                result << "\\t";
+                break;
+            default:
+                if( ch < 0x20 ) {
+                    result << "\\u" << std::hex << std::setw( 4 ) << std::setfill( '0' )
+                           << static_cast<int>( ch ) << std::dec;
+                } else {
+                    result << ch;
+                }
+                break;
+        }
+    }
+    return result.str();
+}
+
+void write_json_string( std::ostream &out, const std::string_view value )
+{
+    out << '"' << json_escape( value ) << '"';
+}
+
+} // namespace
+
+std::string serialize_json( const std::vector<turn_sample> &samples,
+                            const run_metadata &metadata )
+{
+    std::set<std::string, std::less<>> component_ids;
+    for( const turn_sample &turn : samples ) {
+        for( const auto &[id, component] : turn.components ) {
+            static_cast<void>( component );
+            component_ids.insert( id );
+        }
+    }
+
+    std::ostringstream out;
+    out.imbue( std::locale::classic() );
+    out << R"({"schema_version":1,"metadata":{)";
+    const auto member = [&out]( const std::string_view name,
+    const std::string_view value, const bool first ) {
+        if( !first ) {
+            out << ',';
+        }
+        write_json_string( out, name );
+        out << ':';
+        write_json_string( out, value );
+    };
+    member( "seed", metadata.seed, true );
+    member( "git_version", metadata.git_version, false );
+    member( "compiler", metadata.compiler, false );
+    member( "build_options", metadata.build_options, false );
+    member( "cpu_model", metadata.cpu_model, false );
+    member( "windows_version", metadata.windows_version, false );
+    member( "executable_sha256", metadata.executable_sha256, false );
+    out << R"(},"completed_turns":)" << samples.size() << R"(,"components":[)";
+
+    bool first_component = true;
+    for( const std::string &id : component_ids ) {
+        if( !first_component ) {
+            out << ',';
+        }
+        write_json_string( out, id );
+        first_component = false;
+    }
+    out << R"(],"turns":[)";
+
+    for( std::size_t index = 0; index < samples.size(); ++index ) {
+        if( index != 0 ) {
+            out << ',';
+        }
+        const turn_sample &turn = samples[index];
+        out << R"({"index":)" << index << R"(,"game_turn":)" << turn.game_turn
+            << R"(,"total_cycles":)" << turn.total_cycles
+            << R"(,"elapsed_microseconds":)" << turn.elapsed_microseconds
+            << R"(,"components":{)";
+        bool first_turn_component = true;
+        for( const auto &[id, component] : turn.components ) {
+            if( !first_turn_component ) {
+                out << ',';
+            }
+            write_json_string( out, id );
+            out << R"(:{"inclusive_cycles":)" << component.inclusive_cycles
+                << R"(,"exclusive_cycles":)" << component.exclusive_cycles << '}';
+            first_turn_component = false;
+        }
+        out << "}}";
+    }
+    out << "]}";
+    return out.str();
+}
+
+std::string render_html( const std::string_view json )
+{
+    std::string embedded_json;
+    embedded_json.reserve( json.size() );
+    for( const char ch : json ) {
+        if( ch == '<' ) {
+            embedded_json += "\\u003c";
+        } else if( ch == '>' ) {
+            embedded_json += "\\u003e";
+        } else if( ch == '&' ) {
+            embedded_json += "\\u0026";
+        } else {
+            embedded_json += ch;
+        }
+    }
+
+    std::ostringstream out;
+    out << R"HTML(<!doctype html>
+<html lang="en"><head><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>CDDA turn CPU profile</title>
+<style>
+:root{color-scheme:dark;--bg:#111827;--panel:#1f2937;--line:#374151;--text:#f3f4f6;--muted:#9ca3af}
+*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px system-ui,sans-serif}
+main{max-width:1500px;margin:auto;padding:24px}h1,h2{margin:.2em 0 .6em}.meta{color:var(--muted)}
+.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(520px,1fr));gap:16px;margin-top:18px}
+section{background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:16px;overflow:auto}
+canvas{display:block;width:100%;height:320px;background:#0b1220}table{width:100%;border-collapse:collapse}
+th,td{padding:7px;border-bottom:1px solid var(--line);text-align:right}th:first-child,td:first-child{text-align:left}
+select{background:#111827;color:var(--text);border:1px solid var(--line);padding:6px}.legend{display:flex;flex-wrap:wrap;gap:9px;margin-top:8px}
+.swatch{display:inline-block;width:10px;height:10px;margin-right:4px}.detail-row{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;padding:4px 0;border-bottom:1px solid var(--line)}
+</style></head><body><main><h1>CDDA simulation-turn CPU profile</h1><p class="meta" id="metadata"></p>
+<div class="grid"><section><h2>Per-turn exclusive CPU share</h2><canvas id="stacked-chart"></canvas><div class="legend" id="legend"></div></section>
+<section><h2>Turn/component heatmap</h2><canvas id="heatmap"></canvas></section>
+<section><h2>Summary</h2><table id="summary-table"><thead><tr><th>Component</th><th>Inclusive cycles</th><th>Exclusive cycles</th><th>Mean share</th><th>P99 share</th></tr></thead><tbody></tbody></table></section>
+<section><h2>Slow-turn detail</h2><label>Turn <select id="slow-turn-select"></select></label><div id="slow-turn-detail"></div></section></div>
+<script type="application/json" id="profile-data">)HTML"
+        << embedded_json << R"HTML(</script>
+<script>
+(()=>{
+const data=JSON.parse(document.getElementById('profile-data').textContent);const turns=data.turns;
+const ids=data.components;const colors=['#60a5fa','#f59e0b','#34d399','#f472b6','#a78bfa','#fb7185','#22d3ee','#facc15','#4ade80','#c084fc','#94a3b8','#f97316'];
+const value=(t,id)=>t.components[id]?.exclusive_cycles||0;const inclusiveValue=(t,id)=>t.components[id]?.inclusive_cycles||0;const share=(t,id)=>t.total_cycles?value(t,id)/t.total_cycles:0;const hierarchyDepth=id=>id.split('.').length-1;
+document.getElementById('metadata').textContent=`${data.completed_turns} turns · seed ${data.metadata.seed} · ${data.metadata.git_version} · ${data.metadata.cpu_model}`;
+const totals=ids.map(id=>({id,total:turns.reduce((s,t)=>s+value(t,id),0),inclusive:turns.reduce((s,t)=>s+inclusiveValue(t,id),0),shares:turns.map(t=>share(t,id)).sort((a,b)=>a-b)})).sort((a,b)=>b.total-a.total);
+const active=totals.filter(x=>x.total>0||x.inclusive>0);const topComponents=active.filter(x=>x.total>0).slice(0,11).map(x=>x.id);if(!topComponents.includes('unattributed')&&ids.includes('unattributed'))topComponents.push('unattributed');
+function fit(c){const d=devicePixelRatio||1;c.width=Math.max(1,c.clientWidth*d);c.height=Math.max(1,c.clientHeight*d);return d}
+function stacked(){const c=document.getElementById('stacked-chart'),d=fit(c),x=c.getContext('2d');x.clearRect(0,0,c.width,c.height);if(!turns.length)return;
+const w=c.width,h=c.height,n=Math.min(turns.length,Math.floor(w/d)),step=turns.length/n;for(let col=0;col<n;col++){const t=turns[Math.min(turns.length-1,Math.floor(col*step))];let y=h;topComponents.forEach((id,i)=>{const hh=share(t,id)*h;y-=hh;x.fillStyle=colors[i%colors.length];x.fillRect(col*w/n,y,Math.ceil(w/n)+1,hh)})}}
+function heat(){const c=document.getElementById('heatmap'),d=fit(c),x=c.getContext('2d');x.clearRect(0,0,c.width,c.height);if(!turns.length||!active.length)return;const rows=active.slice(0,24),rh=c.height/rows.length,n=Math.min(turns.length,Math.floor(c.width/d)),step=turns.length/n;
+rows.forEach((r,ri)=>{for(let col=0;col<n;col++){const t=turns[Math.min(turns.length-1,Math.floor(col*step))],v=Math.min(1,share(t,r.id)*4);x.fillStyle=`rgb(${Math.round(255*v)},${Math.round(180*v)},${Math.round(60*(1-v))})`;x.fillRect(col*c.width/n,ri*rh,Math.ceil(c.width/n)+1,Math.ceil(rh))}x.fillStyle='#fff';x.fillText(r.id,4,ri*rh+12*d)})}
+const tbody=document.querySelector('#summary-table tbody');active.forEach(r=>{const mean=r.shares.reduce((a,b)=>a+b,0)/(r.shares.length||1),p99=r.shares[Math.min(r.shares.length-1,Math.floor(r.shares.length*.99))]||0;tbody.insertAdjacentHTML('beforeend',`<tr><td>${r.id}</td><td>${r.inclusive.toLocaleString()}</td><td>${r.total.toLocaleString()}</td><td>${(mean*100).toFixed(2)}%</td><td>${(p99*100).toFixed(2)}%</td></tr>`) });
+document.getElementById('legend').innerHTML=topComponents.map((id,i)=>`<span><i class="swatch" style="background:${colors[i%colors.length]}"></i>${id}</span>`).join('');
+const slow=[...turns].sort((a,b)=>b.total_cycles-a.total_cycles).slice(0,20),sel=document.getElementById('slow-turn-select');slow.forEach(t=>sel.add(new Option(`#${t.index} · ${t.total_cycles.toLocaleString()} cycles`,t.index)));
+function detail(){const t=turns[Number(sel.value)]||turns[0];document.getElementById('slow-turn-detail').innerHTML=!t?'':`<p>${t.total_cycles.toLocaleString()} cycles · ${t.elapsed_microseconds.toLocaleString()} μs</p>`+ids.filter(id=>inclusiveValue(t,id)>0).sort((a,b)=>a.localeCompare(b)).map(id=>`<div class="detail-row"><span title="${id}" style="padding-left:${hierarchyDepth(id)*18}px">${id.split('.').pop()}</span><span>${inclusiveValue(t,id).toLocaleString()} incl / ${value(t,id).toLocaleString()} excl</span><span>${(share(t,id)*100).toFixed(2)}%</span></div>`).join('')}sel.addEventListener('change',detail);detail();stacked();heat();addEventListener('resize',()=>{stacked();heat()});
+})();
+</script></main></body></html>)HTML";
+    return out.str();
+}
+
+void write_output_files( const std::filesystem::path &directory,
+                         const run_metadata &metadata )
+{
+    if( !native_recorder ) {
+        throw std::logic_error( "turn profiler is not active" );
+    }
+    std::filesystem::create_directories( directory );
+    const std::string json = serialize_json( native_recorder->samples(), metadata );
+
+    const std::filesystem::path json_path = directory / "turn-profile.json";
+    std::ofstream json_file( json_path, std::ios::binary | std::ios::trunc );
+    if( !json_file ) {
+        throw std::runtime_error( "failed to open turn-profile.json" );
+    }
+    json_file << json;
+    json_file.close();
+    if( !json_file ) {
+        throw std::runtime_error( "failed to write turn-profile.json" );
+    }
+
+    const std::filesystem::path html_path = directory / "turn-profile.html";
+    std::ofstream html_file( html_path, std::ios::binary | std::ios::trunc );
+    if( !html_file ) {
+        throw std::runtime_error( "failed to open turn-profile.html" );
+    }
+    html_file << render_html( json );
+    html_file.close();
+    if( !html_file ) {
+        throw std::runtime_error( "failed to write turn-profile.html" );
+    }
+}
+
+} // namespace turn_profiler
+
+#endif
