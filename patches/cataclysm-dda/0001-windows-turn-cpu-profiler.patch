+std::string profiler_cpu_model()
+{
+#if defined(_MSC_VER)
+    std::array<int, 4> registers {};
+    __cpuid( registers.data(), 0x80000000 );
+    if( static_cast<unsigned int>( registers[0] ) < 0x80000004 ) {
+        return "unknown";
+    }
+    std::array<int, 12> brand_registers{};
+    __cpuid( brand_registers.data(), 0x80000002 );
+    __cpuid( brand_registers.data() + 4, 0x80000003 );
+    __cpuid( brand_registers.data() + 8, 0x80000004 );
+    std::array<char, 49> brand{};
+    std::memcpy( brand.data(), brand_registers.data(), 48 );
+    std::string result( brand.data() );
+    const std::size_t first = result.find_first_not_of( ' ' );
+    return first == std::string::npos ? "unknown" : result.substr( first );
+#else
+    return "unknown";
+#endif
+}
+
+std::string profiler_windows_version()
+{
+#if defined(_WIN32)
+    using rtl_get_version = LONG( WINAPI * )( OSVERSIONINFOW * );
+    const HMODULE ntdll = GetModuleHandleW( L"ntdll.dll" );
+    if( ntdll == nullptr ) {
+        return "unknown";
+    }
+    const auto get_version = reinterpret_cast<rtl_get_version>(
+                                 GetProcAddress( ntdll, "RtlGetVersion" ) );
+    if( get_version == nullptr ) {
+        return "unknown";
+    }
+    OSVERSIONINFOW version {};
+    version.dwOSVersionInfoSize = sizeof( version );
+    if( get_version( &version ) != 0 ) {
+        return "unknown";
+    }
+    return std::to_string( version.dwMajorVersion ) + "." +
+           std::to_string( version.dwMinorVersion ) + "." +
+           std::to_string( version.dwBuildNumber );
+#else
+    return "unsupported";
+#endif
+}
+
+std::string profiler_compiler()
+{
+#if defined(_MSC_FULL_VER)
+    return "MSVC " + std::to_string( _MSC_FULL_VER );
+#else
+    return "unknown";
+#endif
+}
+
+std::string profiler_build_options()
+{
+    std::string result = "TURN_PROFILING=ON";
+#if defined(TILES)
+    result += ";TILES=ON";
+#else
+    result += ";TILES=OFF";
+#endif
+#if defined(SDL_SOUND)
+    result += ";SOUND=ON";
+#else
+    result += ";SOUND=OFF";
+#endif
+    result += ";AUTOSAVE=OFF";
+    return result;
+}
+
+int run_turn_profile( const cli_opts &cli )
+{
+    get_options().get_option( "AUTOSAVE" ).setValue( "false" );
+    turn_profiler::start( cli.turn_profile_turns );
+    main_menu menu;
+    if( !menu.opening_screen() ) {
+        throw std::runtime_error(
+            "turn profiler could not create and start its game" );
+    }
+    avatar &player = get_avatar();
+    get_event_bus().send<event_type::game_begin>( getVersionString() );
+    bool game_ended = false;
+    for( std::size_t index = 0; index < cli.turn_profile_turns; ++index ) {
+        player.set_moves( 0 );
+        const std::int64_t game_turn =
+            to_turns<std::int64_t>( calendar::turn - calendar::turn_zero );
+        turn_profiler::begin_turn( game_turn );
+        game_ended = g->do_turn();
+        turn_profiler::end_turn();
+        if( game_ended ) {
+            break;
+        }
+        if( ( index + 1 ) % 1'000 == 0 ) {
+            std::cout << "Profiled " << index + 1 << " / " << cli.turn_profile_turns
+                      << " turns\n";
+        }
+    }
+
+    turn_profiler::run_metadata metadata;
+    metadata.seed = cli.turn_profile_seed_label.empty()
+                    ? std::to_string( cli.seed )
+                    : cli.turn_profile_seed_label;
+    metadata.git_version = getVersionString();
+    metadata.compiler = profiler_compiler();
+    metadata.build_options = profiler_build_options();
+    metadata.cpu_model = profiler_cpu_model();
+    metadata.windows_version = profiler_windows_version();
+    metadata.executable_sha256 = cli.turn_profile_executable_sha256;
+    turn_profiler::write_output_files(
+        std::filesystem::u8path( cli.turn_profile_output ), metadata );
+
+    const std::size_t completed = turn_profiler::samples().size();
+    turn_profiler::stop();
+    std::cout << "Turn profile written to " << cli.turn_profile_output << " ("
+              << completed << " turns)\n";
+    return game_ended || completed != cli.turn_profile_turns ? 2 : 0;
+}
