             add_dependencies(cata_test test_mo)
         endif()
diff --git a/tests/turn_profiler_test.cpp b/tests/turn_profiler_test.cpp
new file mode 100644
index 00000000000..89303254eb2
--- /dev/null
+++ b/tests/turn_profiler_test.cpp
@@ -0,0 +1,188 @@
+#include "catch/catch.hpp"
+
+#if defined(CATA_ENABLE_TURN_PROFILER)
+
+#include <locale>
+
+#include "turn_profiler.h"
+
+namespace
+{
+
+class grouped_numbers : public std::numpunct<char>
+{
+    protected:
+        char do_thousands_sep() const override {
+            return ',';
+        }
+
+        std::string do_grouping() const override {
+            return "\3";
+        }
+};
+
+} // namespace
+
+TEST_CASE( "turn profiler separates inclusive and exclusive CPU cycles",
+           "[turn_profiler]" )
+{
+    turn_profiler::recorder recorder( 1 );
+
+    recorder.begin_turn( 42, 100, 100, 1'000 );
+    recorder.enter_region( "map", 10 );
+    recorder.enter_region( "map.fields", 20 );
+    recorder.leave_region( 50 );
+    recorder.leave_region( 80 );
+    const turn_profiler::turn_sample sample = recorder.end_turn( 200, 200, 1'250 );
+
+    CHECK( sample.game_turn == 42 );
+    CHECK( sample.total_cycles == 100 );
+    CHECK( sample.elapsed_microseconds == 250 );
+
+    const turn_profiler::component_sample &map = sample.components.at( "map" );
+    CHECK( map.inclusive_cycles == 70 );
+    CHECK( map.exclusive_cycles == 40 );
+
+    const turn_profiler::component_sample &fields =
+        sample.components.at( "map.fields" );
+    CHECK( fields.inclusive_cycles == 30 );
+    CHECK( fields.exclusive_cycles == 30 );
+
+    const turn_profiler::component_sample &unattributed =
+        sample.components.at( "unattributed" );
+    CHECK( unattributed.exclusive_cycles == 30 );
+}
+
+TEST_CASE( "turn profiler rejects mismatched region nesting",
+           "[turn_profiler]" )
+{
+    turn_profiler::recorder recorder( 1 );
+
+    recorder.begin_turn( 7, 10, 10, 100 );
+    recorder.enter_region( "weather", 12 );
+
+    CHECK_THROWS_WITH( recorder.end_turn( 20, 20, 200 ),
+                       "turn profiler ended a turn with open regions" );
+}
+
+TEST_CASE( "turn profiler accounts for background CPU cycles",
+           "[turn_profiler]" )
+{
+    turn_profiler::recorder recorder( 1 );
+    recorder.begin_turn( 8, 100, 100, 500 );
+    recorder.enter_region( "weather", 10 );
+    recorder.leave_region( 70 );
+
+    const turn_profiler::turn_sample sample = recorder.end_turn( 200, 190, 700 );
+
+    CHECK( sample.components.at( "weather" ).exclusive_cycles == 60 );
+    CHECK( sample.components.at( "background.other" ).exclusive_cycles == 10 );
+    CHECK( sample.components.at( "unattributed" ).exclusive_cycles == 30 );
+}
+
+TEST_CASE( "turn profiler derives aggregate background CPU cycles",
+           "[turn_profiler]" )
+{
+    CHECK( turn_profiler::derive_background_cycles( 100, 200, 120, 180 ) == 40 );
+    CHECK( turn_profiler::derive_background_cycles( 100, 200, 120, 240 ) == 0 );
+    CHECK( turn_profiler::derive_background_cycles( 200, 100, 120, 180 ) == 0 );
+}
+
+TEST_CASE( "turn profiler derives missing hierarchy parents",
+           "[turn_profiler]" )
+{
+    turn_profiler::recorder recorder( 1 );
+    recorder.begin_turn( 10, 100, 100, 500 );
+    recorder.enter_region( "map.fields", 10 );
+    recorder.leave_region( 30 );
+    recorder.enter_region( "map.items", 40 );
+    recorder.leave_region( 70 );
+
+    const turn_profiler::turn_sample sample = recorder.end_turn( 200, 200, 700 );
+
+    CHECK( sample.components.at( "map" ).inclusive_cycles == 50 );
+    CHECK( sample.components.at( "map" ).exclusive_cycles == 0 );
+}
+
+TEST_CASE( "turn profiler renders raw data and all required HTML views",
+           "[turn_profiler]" )
+{
+    turn_profiler::recorder recorder( 1 );
+    recorder.begin_turn( 1'234'567, 1'000, 1'000, 2'000 );
+    recorder.enter_region( "weather", 100 );
+    recorder.leave_region( 160 );
+    recorder.end_turn( 1'100, 1'100, 2'250 );
+
+    turn_profiler::run_metadata metadata;
+    metadata.seed = "fixed-seed";
+    metadata.git_version = "test-version";
+    metadata.compiler = "test-compiler";
+    metadata.build_options = "TURN_PROFILING=ON";
+    metadata.cpu_model = "test-cpu";
+    metadata.windows_version = "test-windows";
+    metadata.executable_sha256 = "test-hash";
+
+    const std::locale previous_locale = std::locale();
+    std::locale::global( std::locale( previous_locale, new grouped_numbers ) );
+    const std::string json =
+        turn_profiler::serialize_json( recorder.samples(), metadata );
+    std::locale::global( previous_locale );
+    CHECK( json.find( R"("completed_turns":1)" ) != std::string::npos );
+    CHECK( json.find( R"("game_turn":1234567)" ) != std::string::npos );
+    CHECK( json.find( R"("unattributed")" ) != std::string::npos );
+
+    const std::string html = turn_profiler::render_html( json );
+    CHECK( html.find( R"(id="stacked-chart")" ) != std::string::npos );
+    CHECK( html.find( R"(id="heatmap")" ) != std::string::npos );
+    CHECK( html.find( R"(id="summary-table")" ) != std::string::npos );
+    CHECK( html.find( R"(id="slow-turn-detail")" ) != std::string::npos );
+    CHECK( html.find( "hierarchyDepth" ) != std::string::npos );
+    CHECK( html.find( R"("completed_turns":1)" ) != std::string::npos );
+    CHECK( html.find( "(()=>{" ) != std::string::npos );
+    CHECK( html.find( "const top=" ) == std::string::npos );
+}
+
+#if defined(_WIN32)
+TEST_CASE( "Windows CPU cycle counters are monotonic", "[turn_profiler]" )
+{
+    const std::uint64_t process_before = turn_profiler::read_process_cycles();
+    const std::uint64_t thread_before = turn_profiler::read_thread_cycles();
+    volatile std::uint64_t work = 0;
+    for( std::uint64_t i = 0; i < 100'000; ++i ) {
+        work += i;
+    }
+    static_cast<void>( work );
+
+    CHECK( turn_profiler::read_process_cycles() >= process_before );
+    CHECK( turn_profiler::read_thread_cycles() >= thread_before );
+}
+
+TEST_CASE( "native turn profiler records an RAII region", "[turn_profiler]" )
+{
+    turn_profiler::start( 1 );
+    turn_profiler::begin_turn( 100 );
+    {
+        turn_profiler::scoped_region region( "map.items" );
+        volatile std::uint64_t work = 0;
+        for( std::uint64_t i = 0; i < 100'000; ++i ) {
+            work += i;
+        }
+        static_cast<void>( work );
+    }
+    turn_profiler::end_turn();
+
+    REQUIRE( turn_profiler::samples().size() == 1 );
+    CHECK( turn_profiler::samples()
+           .front()
+           .components.at( "map.items" )
+           .exclusive_cycles > 0 );
+    CHECK( turn_profiler::samples()
+           .front()
+           .components.at( "profiler" )
+           .exclusive_cycles > 0 );
+    CHECK( turn_profiler::is_complete() );
+    turn_profiler::stop();
+}
+#endif
+
+#endif
diff --git a/tools/profile-turns.ps1 b/tools/profile-turns.ps1
new file mode 100644
index 00000000000..a1d822c00cb
--- /dev/null
+++ b/tools/profile-turns.ps1
@@ -0,0 +1,521 @@
+#requires -Version 5.1
+
+<#
+.SYNOPSIS
+Builds and runs the Windows simulation-turn CPU profiler.
+
+.DESCRIPTION
+The script reuses an existing compatible CMake build directory when one is available.
+It enables TURN_PROFILING, rebuilds only affected source files, creates an isolated game,
+and advances that game for a fixed number of simulation turns. The run writes raw JSON
+and a self-contained HTML report. The default run records 10,000 turns with a fixed seed.
+
+The script restores TURN_PROFILING to its original value after the run. If the run succeeds,
+the script deletes the temporary game world. If the run fails, the script preserves the
+temporary game world and prints its path.
+
+.PARAMETER Turns
+Specifies the number of simulation turns. The default is 10000.
+
+.PARAMETER Seed
+Specifies the deterministic random-number seed.
+
+.PARAMETER BuildDirectory
+Specifies a compatible CMake build directory. The script first uses the outer workspace's
+build\cmake directory when that directory exists.
+
+.PARAMETER OutputDirectory
+Specifies the result directory. The script creates a timestamped directory by default.
+
+.PARAMETER NoOpen
+Prevents the script from opening the HTML report after a successful run.
+
+.EXAMPLE
+pwsh -File tools\profile-turns.ps1
+
+Builds the profiler incrementally, records 10,000 turns, and opens the HTML report.
+
+.EXAMPLE
+pwsh -File tools\profile-turns.ps1 -Turns 500 -NoOpen
+
+Records 500 turns and leaves the HTML report closed.
+#>
+
+[CmdletBinding()]
+param(
+    [ValidateRange(1, 1000000)]
+    [int] $Turns = 10000,
+
+    [ValidateNotNullOrEmpty()]
+    [string] $Seed = 'cdda-turn-profile-v1',
+
+    [string] $BuildDirectory,
+
+    [string] $OutputDirectory,
+
+    [switch] $NoOpen
+)
+
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version 3.0
+
+function Invoke-Checked {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $Command,
+
+        [Parameter(Mandatory = $true)]
+        [string[]] $Arguments
+    )
+
+    Write-Host "> $Command $($Arguments -join ' ')"
+    & $Command @Arguments
+    if ($LASTEXITCODE -ne 0) {
+        throw "Command failed with exit code $LASTEXITCODE`: $Command"
+    }
+}
+
+function ConvertTo-NativeArgument {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $Argument
+    )
+
+    if ($Argument.Contains('"')) {
+        throw 'Native process arguments cannot contain a quotation mark.'
+    }
+    $escaped = [regex]::Replace($Argument, '(\\+)$', '$1$1')
+    return '"' + $escaped + '"'
+}
+
+function Invoke-GameProcess {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $Executable,
+
+        [Parameter(Mandatory = $true)]
+        [string[]] $Arguments,
+
+        [Parameter(Mandatory = $true)]
+        [string] $WorkingDirectory
+    )
+
+    $startInfo = [Diagnostics.ProcessStartInfo]::new()
+    $startInfo.FileName = $Executable
+    $startInfo.WorkingDirectory = $WorkingDirectory
+    $startInfo.UseShellExecute = $false
+    $startInfo.Arguments = ($Arguments | ForEach-Object {
+        ConvertTo-NativeArgument -Argument $_
+    }) -join ' '
+    Write-Host "> $Executable $($Arguments -join ' ')"
+    $process = [Diagnostics.Process]::Start($startInfo)
+    $process.WaitForExit()
+    if ($process.ExitCode -ne 0) {
+        throw "Game process failed with exit code $($process.ExitCode)."
+    }
+}
+
+function Get-HeadlessBrowser {
+    $candidates = @(
+        (Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'),
+        (Join-Path $env:ProgramFiles 'Microsoft\Edge\Application\msedge.exe'),
+        (Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe')
+    )
+    foreach ($candidate in $candidates) {
+        if (Test-Path -LiteralPath $candidate -PathType Leaf) {
+            return $candidate
+        }
+    }
+    throw 'Microsoft Edge or Google Chrome is required to validate the HTML report.'
+}
+
+function Assert-HtmlReportRenders {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $HtmlPath,
+
+        [Parameter(Mandatory = $true)]
+        [string] $BrowserProfileDirectory
+    )
+
+    New-Item -ItemType Directory -Path $BrowserProfileDirectory -Force | Out-Null
+    $browser = Get-HeadlessBrowser
+    $arguments = @(
+        '--headless=new',
+        '--disable-gpu',
+        '--disable-extensions',
+        '--no-first-run',
+        "--user-data-dir=$BrowserProfileDirectory",
+        '--dump-dom',
+        ([Uri]::new([IO.Path]::GetFullPath($HtmlPath)).AbsoluteUri)
+    )
+    $startInfo = [Diagnostics.ProcessStartInfo]::new()
+    $startInfo.FileName = $browser
+    $startInfo.UseShellExecute = $false
+    $startInfo.CreateNoWindow = $true
+    $startInfo.RedirectStandardOutput = $true
+    $startInfo.RedirectStandardError = $true
+    $startInfo.Arguments = ($arguments | ForEach-Object {
+        ConvertTo-NativeArgument -Argument $_
+    }) -join ' '
+    $process = [Diagnostics.Process]::Start($startInfo)
+    $outputTask = $process.StandardOutput.ReadToEndAsync()
+    $errorTask = $process.StandardError.ReadToEndAsync()
+    $process.WaitForExit()
+    $renderedHtml = $outputTask.GetAwaiter().GetResult()
+    $browserError = $errorTask.GetAwaiter().GetResult()
+    if ($process.ExitCode -ne 0) {
+        throw "HTML report browser validation failed with exit code $($process.ExitCode): $browserError"
+    }
+    if ($renderedHtml -notmatch '<p class="meta" id="metadata">[^<]+</p>') {
+        throw 'The HTML report loaded, but its JavaScript did not render the metadata.'
+    }
+}
+
+function Get-VisualStudioRoot {
+    $vswhere = Join-Path ${env:ProgramFiles(x86)} `
+        'Microsoft Visual Studio\Installer\vswhere.exe'
+    if (Test-Path -LiteralPath $vswhere -PathType Leaf) {
+        $path = & $vswhere -products '*' -version '[17.0,18.0)' -latest `
+            -property installationPath -requires `
+            Microsoft.VisualStudio.Component.VC.Tools.x86.x64 `
+            Microsoft.VisualStudio.Component.VC.CMake.Project |
+            Select-Object -First 1
+        if ($path) {
+            return $path.Trim()
+        }
+    }
+
+    $fallback = Join-Path $env:ProgramFiles 'Microsoft Visual Studio\2022\Community'
+    if (Test-Path -LiteralPath $fallback -PathType Container) {
+        return $fallback
+    }
+    throw 'Visual Studio 2022 with MSVC and CMake was not found.'
+}
+
+function Get-CMakeCommand {
+    $command = Get-Command cmake.exe -ErrorAction SilentlyContinue
+    if ($command) {
+        return $command.Source
+    }
+    $candidate = Join-Path (Get-VisualStudioRoot) `
+        'Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe'
+    if (Test-Path -LiteralPath $candidate -PathType Leaf) {
+        return $candidate
+    }
+    throw 'CMake was not found.'
+}
+
+function Assert-ChildPath {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $Path,
+
+        [Parameter(Mandatory = $true)]
+        [string] $Parent
+    )
+
+    $resolvedPath = [IO.Path]::GetFullPath($Path).TrimEnd('\', '/')
+    $resolvedParent = [IO.Path]::GetFullPath($Parent).TrimEnd('\', '/')
+    $prefix = $resolvedParent + [IO.Path]::DirectorySeparatorChar
+    if (-not $resolvedPath.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) {
+        throw "The temporary path is outside its required parent: $resolvedPath"
+    }
+}
+
+function Get-CacheValue {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $CachePath,
+
+        [Parameter(Mandatory = $true)]
+        [string] $Name
+    )
+
+    if (-not (Test-Path -LiteralPath $CachePath -PathType Leaf)) {
+        return $null
+    }
+    $match = Select-String -LiteralPath $CachePath `
+        -Pattern ("^{0}:[^=]*=(.*)$" -f [regex]::Escape($Name)) |
+        Select-Object -First 1
+    if ($match) {
+        return $match.Matches[0].Groups[1].Value
+    }
+    return $null
+}
+
+function Set-ShaderEnvironment {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $CMakeRoot
+    )
+
+    $toolRoot = Join-Path $CMakeRoot 'vcpkg_installed\x64-windows-static\tools'
+    $glslang = Join-Path $toolRoot 'glslang\glslangValidator.exe'
+    $shadercross = Join-Path $toolRoot 'sdl3-shadercross\shadercross.exe'
+    foreach ($path in @($glslang, $shadercross)) {
+        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
+            throw "A required shader tool was not found: $path"
+        }
+    }
+    $env:GLSLANG = $glslang
+    $env:SDL_SHADERCROSS = $shadercross
+}
+
+function Invoke-MsvcProfilerBuild {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $CMakeRoot,
+
+        [Parameter(Mandatory = $true)]
+        [bool] $ProfilingEnabled,
+
+        [bool] $ForceRecompile = $false
+    )
+
+    $msbuild = Join-Path (Get-VisualStudioRoot) 'MSBuild\Current\Bin\MSBuild.exe'
+    if (-not (Test-Path -LiteralPath $msbuild -PathType Leaf)) {
+        throw "MSBuild was not found: $msbuild"
+    }
+    $commonProject = Join-Path $CMakeRoot 'src\cataclysm-tiles-common.vcxproj'
+    $gameProject = Join-Path $CMakeRoot 'src\cataclysm-tiles.vcxproj'
+    foreach ($project in @($commonProject, $gameProject)) {
+        if (-not (Test-Path -LiteralPath $project -PathType Leaf)) {
+            throw "A required MSVC project was not found: $project"
+        }
+    }
+
+    $commonSources = @('do_turn.cpp', 'main_menu.cpp', 'newcharacter.cpp')
+    foreach ($name in $commonSources) {
+        $source = Join-Path $sourceRoot "src\$name"
+        $object = Join-Path $CMakeRoot `
+            "src\cataclysm-tiles-common.dir\RelWithDebInfo\$($name -replace '\.cpp$', '.obj')"
+        if (-not $ForceRecompile -and (Test-Path -LiteralPath $object -PathType Leaf) -and
+                (Get-Item -LiteralPath $object).Length -gt 0 -and
+                (Get-Item -LiteralPath $object).LastWriteTimeUtc -ge
+                (Get-Item -LiteralPath $source).LastWriteTimeUtc) {
+            continue
+        }
+        Invoke-Checked -Command $msbuild -Arguments @(
+            $commonProject,
+            '/nologo',
+            '/t:ClCompile',
+            '/p:Configuration=RelWithDebInfo',
+            '/p:Platform=x64',
+            "/p:SelectedFiles=$source",
+            '/p:SelectedFilesBuildPCH=false',
+            '/verbosity:minimal',
+            '/m'
+        )
+    }
+
+    $gameSources = @('main.cpp')
+    if ($ProfilingEnabled) {
+        $gameSources += 'turn_profiler.cpp'
+    }
+    foreach ($name in $gameSources) {
+        $source = Join-Path $sourceRoot "src\$name"
+        $object = Join-Path $CMakeRoot `
+            "src\cataclysm-tiles.dir\RelWithDebInfo\$($name -replace '\.cpp$', '.obj')"
+        if (-not $ForceRecompile -and (Test-Path -LiteralPath $object -PathType Leaf) -and
+                (Get-Item -LiteralPath $object).Length -gt 0 -and
+                (Get-Item -LiteralPath $object).LastWriteTimeUtc -ge
+                (Get-Item -LiteralPath $source).LastWriteTimeUtc) {
+            continue
+        }
+        Invoke-Checked -Command $msbuild -Arguments @(
+            $gameProject,
+            '/nologo',
+            '/t:ClCompile',
+            '/p:Configuration=RelWithDebInfo',
+            '/p:Platform=x64',
+            "/p:SelectedFiles=$source",
+            '/p:SelectedFilesBuildPCH=false',
+            '/verbosity:minimal',
+            '/m'
+        )
+    }
+
+    Invoke-Checked -Command $msbuild -Arguments @(
+        $commonProject,
+        '/nologo',
+        '/t:FinalizeBuildStatus',
+        '/p:Configuration=RelWithDebInfo',
+        '/p:Platform=x64',
+        '/p:BuildProjectReferences=false',
+        '/verbosity:minimal'
+    )
+    Invoke-Checked -Command $msbuild -Arguments @(
+        $gameProject,
+        '/nologo',
+        '/t:Build',
+        '/p:Configuration=RelWithDebInfo',
+        '/p:Platform=x64',
+        '/p:BuildProjectReferences=false',
+        '/verbosity:minimal',
+        '/m'
+    )
+}
+
+function Invoke-ProfilerBuild {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string] $CMakeRoot,
+
+        [Parameter(Mandatory = $true)]
+        [bool] $ProfilingEnabled,
+
+        [bool] $ForceRecompile = $false
+    )
+
+    $cache = Join-Path $CMakeRoot 'CMakeCache.txt'
+    $generator = Get-CacheValue -CachePath $cache -Name 'CMAKE_GENERATOR'
+    if ($generator -eq 'Visual Studio 17 2022') {
+        Invoke-MsvcProfilerBuild -CMakeRoot $CMakeRoot `
+            -ProfilingEnabled $ProfilingEnabled -ForceRecompile $ForceRecompile
+        return
+    }
+    Invoke-Checked -Command $cmake -Arguments @(
+        '--build', $CMakeRoot,
+        '--config', 'RelWithDebInfo',
+        '--parallel',
+        '--target', 'cataclysm-tiles'
+    )
+}
+
+$sourceRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
+$workspaceRoot = [IO.Path]::GetFullPath((Join-Path $sourceRoot '..'))
+$defaultBuild = Join-Path $workspaceRoot 'build\cmake'
+if (-not $BuildDirectory) {
+    if (Test-Path -LiteralPath (Join-Path $defaultBuild 'CMakeCache.txt') -PathType Leaf) {
+        $BuildDirectory = $defaultBuild
+    } else {
+        $BuildDirectory = Join-Path $sourceRoot 'out\build\windows-turn-profiler'
+    }
+}
+$BuildDirectory = [IO.Path]::GetFullPath($BuildDirectory)
+
+if (-not $OutputDirectory) {
+    $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
+    $OutputDirectory = Join-Path $sourceRoot "turn-profile-results\$stamp"
+}
+$OutputDirectory = [IO.Path]::GetFullPath($OutputDirectory)
+
+$runParent = Join-Path $BuildDirectory 'turn-profile-runs'
+$runRoot = Join-Path $runParent ([guid]::NewGuid().ToString('N'))
+Assert-ChildPath -Path $runRoot -Parent $runParent
+New-Item -ItemType Directory -Path $runRoot -Force | Out-Null
+New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
+
+$cmake = Get-CMakeCommand
+$cachePath = Join-Path $BuildDirectory 'CMakeCache.txt'
+$originalProfiling = Get-CacheValue -CachePath $cachePath -Name 'TURN_PROFILING'
+$restoreProfiling = $originalProfiling -ne 'ON'
+$profileSucceeded = $false
+$profileConfigured = $false
+
+try {
+    if (-not (Test-Path -LiteralPath $cachePath -PathType Leaf)) {
+        $vsRoot = Get-VisualStudioRoot
+        $env:VCPKG_ROOT = Join-Path $vsRoot 'VC\vcpkg'
+        Invoke-Checked -Command $cmake -Arguments @(
+            '-S', $sourceRoot,
+            '-B', $BuildDirectory,
+            '--preset', 'windows-tiles-sounds-x64-msvc',
+            '--log-level=WARNING',
+            '-DTURN_PROFILING:BOOL=ON',
+            '-DLOCALIZE:BOOL=OFF',
+            '-DTESTS:BOOL=ON'
+        )
+    } else {
+        $configuredSource = Get-CacheValue -CachePath $cachePath `
+            -Name 'CMAKE_HOME_DIRECTORY'
+        if (-not $configuredSource -or
+                [IO.Path]::GetFullPath($configuredSource) -ne $sourceRoot) {
+            throw "The CMake build directory belongs to another source tree: $BuildDirectory"
+        }
+        Invoke-Checked -Command $cmake -Arguments @(
+            '-S', $sourceRoot,
+            '-B', $BuildDirectory,
+            '--log-level=WARNING',
+            '-DTURN_PROFILING:BOOL=ON'
+        )
+    }
+    $profileConfigured = $true
+    Set-ShaderEnvironment -CMakeRoot $BuildDirectory
+    Invoke-ProfilerBuild -CMakeRoot $BuildDirectory -ProfilingEnabled $true `
+        -ForceRecompile $true
+
+    $executable = Get-ChildItem -LiteralPath $BuildDirectory `
+        -Filter 'cataclysm-tiles.exe' -File -Recurse |
+        Where-Object { $_.FullName -match '[\\/]RelWithDebInfo[\\/]' } |
+        Select-Object -First 1
+    if (-not $executable) {
+        throw 'The RelWithDebInfo cataclysm-tiles.exe was not found.'
+    }
+    $sha256 = (Get-FileHash -LiteralPath $executable.FullName -Algorithm SHA256).Hash
+
+    Invoke-GameProcess -Executable $executable.FullName -WorkingDirectory $sourceRoot `
+        -Arguments @(
+        '--basepath', $sourceRoot,
+        '--userdir', $runRoot,
+        '--seed', $Seed,
+        '--noverify',
+        '--disable-ascii-art',
+        '--turn-profile', $Turns.ToString([Globalization.CultureInfo]::InvariantCulture),
+        '--turn-profile-output', $OutputDirectory,
+        '--turn-profile-executable-sha256', $sha256,
+        '--turn-profile-seed-label', $Seed
+    )
+
+    $jsonPath = Join-Path $OutputDirectory 'turn-profile.json'
+    $htmlPath = Join-Path $OutputDirectory 'turn-profile.html'
+    foreach ($path in @($jsonPath, $htmlPath)) {
+        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
+            throw "The profiler did not create a required result file: $path"
+        }
+    }
+    $profile = Get-Content -Raw -LiteralPath $jsonPath | ConvertFrom-Json
+    if ([int]$profile.completed_turns -ne $Turns) {
+        throw "The profiler recorded $($profile.completed_turns) turns instead of $Turns."
+    }
+    if (@($profile.turns).Count -ne $Turns) {
+        throw "The profiler wrote $(@($profile.turns).Count) turn records instead of $Turns."
+    }
+    if ($profile.metadata.executable_sha256 -ne $sha256) {
+        throw 'The profile metadata does not identify the executable that was run.'
+    }
+    $browserProfile = Join-Path $runRoot 'report-browser-profile'
+    Assert-ChildPath -Path $browserProfile -Parent $runRoot
+    Assert-HtmlReportRenders -HtmlPath $htmlPath `
+        -BrowserProfileDirectory $browserProfile
+    $profileSucceeded = $true
+
+    Write-Host ''
+    Write-Host "Raw data: $jsonPath"
+    Write-Host "HTML report: $htmlPath"
+    if (-not $NoOpen) {
+        Start-Process -FilePath $htmlPath
+    }
+} finally {
+    if ($restoreProfiling -and $profileConfigured) {
+        Write-Host 'Restoring the non-profiled build configuration.'
+        Invoke-Checked -Command $cmake -Arguments @(
+            '-S', $sourceRoot,
+            '-B', $BuildDirectory,
+            '--log-level=WARNING',
+            '-DTURN_PROFILING:BOOL=OFF'
+        )
+        Set-ShaderEnvironment -CMakeRoot $BuildDirectory
+        Invoke-ProfilerBuild -CMakeRoot $BuildDirectory -ProfilingEnabled $false `
+            -ForceRecompile $true
+    }
+
+    if ($profileSucceeded) {
+        if (Test-Path -LiteralPath $runRoot) {
+            Remove-Item -LiteralPath $runRoot -Recurse -Force
+        }
+    } else {
+        Write-Warning "The temporary game was preserved: $runRoot"
+    }
+}
