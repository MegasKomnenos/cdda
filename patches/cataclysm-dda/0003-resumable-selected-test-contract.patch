+struct test_plan_chunk {
+    std::string id;
+    unsigned int seed = 0;
+    std::vector<std::string> tests;
+    std::string output_dir;
+};
+
+static std::vector<test_plan_chunk> load_test_plan( const std::string &path )
+{
+    std::ifstream input( std::filesystem::u8path( path ) );
+    if( !input.is_open() ) {
+        throw std::runtime_error( "Unable to open test plan: " + path );
+    }
+    TextJsonIn jsin( input );
+    TextJsonObject root = jsin.get_object();
+    if( root.get_int( "schema_version" ) != 1 ) {
+        root.throw_error_at( "schema_version", "test plan schema_version must be 1" );
+    }
+
+    std::vector<test_plan_chunk> result;
+    for( TextJsonObject chunk_object : root.get_array( "chunks" ) ) {
+        test_plan_chunk chunk;
+        chunk.id = chunk_object.get_string( "id" );
+        uint64_t seed = 0;
+        chunk_object.read( "seed", seed );
+        if( seed > std::numeric_limits<unsigned int>::max() ) {
+            chunk_object.throw_error_at( "seed", "test plan seed is out of range" );
+        }
+        chunk.seed = static_cast<unsigned int>( seed );
+        chunk.output_dir = chunk_object.get_string( "output_dir" );
+        for( const std::string test : chunk_object.get_array( "tests" ) ) {
+            chunk.tests.push_back( test );
+        }
+        if( chunk.id.empty() || chunk.seed == 0 || chunk.tests.empty() || chunk.output_dir.empty() ) {
+            chunk_object.throw_error( "test plan chunk has an empty required field" );
+        }
+        result.push_back( std::move( chunk ) );
+    }
+    if( result.empty() ) {
+        root.throw_error_at( "chunks", "test plan has no chunks" );
+    }
+    return result;
+}
+
+static std::string make_test_filter( const std::vector<std::string> &tests )
+{
+    std::string result;
+    for( const std::string &test : tests ) {
+        if( !result.empty() ) {
+            result.push_back( ',' );
+        }
+        result += test;
+    }
+    return result;
+}
+
+static std::chrono::steady_clock::time_point test_case_start_time;
+
+static int64_t unix_time_milliseconds()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::system_clock::now().time_since_epoch() ).count();
+}
+
+static void write_progress_event( const std::string &event,
+                                  const std::function<void( JsonOut & )> &write_members )
+{
+    if( !progress_log.is_open() ) {
+        return;
+    }
+
+    std::ostringstream line;
+    JsonOut jsout( line );
+    jsout.start_object();
+    jsout.member( "schema_version", 1 );
+    jsout.member( "event", event );
+    jsout.member( "timestamp_unix_ms", unix_time_milliseconds() );
+    if( !current_chunk_id.empty() ) {
+        jsout.member( "chunk_id", current_chunk_id );
+    }
+    write_members( jsout );
+    jsout.end_object();
+    progress_log << line.str() << '\n';
+    progress_log.flush();
+}
+
+static bool totals_failed( const Catch::Totals &totals )
+{
+    return totals.error != 0 || totals.assertions.failed != 0 || totals.testCases.failed != 0;
+}
