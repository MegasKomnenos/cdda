@@ -0,0 +1,30 @@
+#include "test_output.h"
+
+#include <stdexcept>
+
+namespace
+{
+std::filesystem::path output_dir;
+} // namespace
+
+void set_test_output_dir( const std::filesystem::path &path )
+{
+    output_dir = path;
+}
+
+const std::filesystem::path &test_output_dir()
+{
+    if( output_dir.empty() ) {
+        throw std::logic_error( "test output directory has not been initialized" );
+    }
+    return output_dir;
+}
+
+std::filesystem::path test_output_path( const std::string_view filename )
+{
+    const std::filesystem::path relative = std::filesystem::u8path( filename );
+    if( relative.empty() || relative.is_absolute() || relative.has_parent_path() ) {
+        throw std::invalid_argument( "test output filename must be a single relative path component" );
+    }
+    return test_output_dir() / relative;
+}
