+++ b/tests/test_output_test.cpp
@@ -0,0 +1,47 @@
+#include <cstdlib>
+#include <fstream>
+#include <string>
+
+#include "cata_catch.h"
+#include "test_output.h"
+
+TEST_CASE( "test_output_directory", "[.][nogame][test_harness]" )
+{
+    const std::filesystem::path path = test_output_path( "test-output-smoke.txt" );
+    {
+        std::ofstream output( path, std::ios::out | std::ios::trunc );
+        REQUIRE( output.is_open() );
+        output << "test harness output\n";
+    }
+
+    std::ifstream input( path );
+    REQUIRE( input.is_open() );
+    std::string line;
+    std::getline( input, line );
+    CHECK( line == "test harness output" );
+    CHECK_THROWS( test_output_path( "../outside.txt" ) );
+}
+
+TEST_CASE( "test_harness_crash_once", "[.][nogame][test_harness]" )
+{
+    std::string attempt;
+    for( std::filesystem::path path = test_output_dir(); !path.empty(); path = path.parent_path() ) {
+        const std::string component = path.filename().string();
+        if( component.rfind( "attempt-", 0 ) == 0 ) {
+            attempt = component;
+            break;
+        }
+        if( path == path.parent_path() ) {
+            break;
+        }
+    }
+    if( attempt == "attempt-0001" ) {
+        std::_Exit( 99 );
+    }
+    CHECK( attempt == "attempt-0002" );
+}
+
+TEST_CASE( "test_harness_expected_failure", "[.][nogame][test_harness]" )
+{
+    CHECK( false );
+}
